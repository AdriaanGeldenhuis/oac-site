Options -Indexes

# DISABLE ALL VARNISH CACHING - serve fresh content always
<IfModule mod_headers.c>
  # Tell Varnish and browsers not to cache anything
  Header set Cache-Control "private, no-cache, no-store, must-revalidate, max-age=0"
  Header set Pragma "no-cache"
  Header set Expires "0"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>

# Blokkeer toegang tot sensitiewe bestande
<FilesMatch "^(config|session|auth|csrf|headers|session_guard)\.php$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Protect all config files
<FilesMatch "^config\.php$">
  Order Allow,Deny
  Deny from all
</FilesMatch>
